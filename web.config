<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="HttpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform
      processPath="python.exe"
      arguments="%home%\site-packages\mcp\__main__.py server"
      stdoutLogEnabled="true"
      stdoutLogFile="%home%\LogFiles\stdout">
    </httpPlatform>
  </system.webServer>
</configuration>
